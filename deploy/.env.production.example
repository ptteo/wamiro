# Production template for /opt/wamiro/.env (Lightsail Mumbai).
# Copy: cp deploy/.env.production.example /opt/wamiro/.env && vi /opt/wamiro/.env
# Never commit real secrets.

DATABASE_URL=postgresql://USER:PASSWORD@your-rds.ap-south-1.rds.amazonaws.com:5432/wamiro?sslmode=require

APP_URL=https://work-portal.howdyanalytics.com

# Required in production (>=16 chars). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

WAMIRO_DATA_DIR=/opt/wamiro/data

# Seed once after first migrate (optional)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# AI (optional)
AI_BASE_URL=https://router.bynara.id/v1
AI_API_KEY=
AI_MODEL=

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
S3_BUCKET=wamiro-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Email (Brevo / any SMTP)
SMTP_URL=smtp://USER:PASS@smtp-relay.brevo.com:587
MAIL_FROM=Wamiro <techteam.howdyanalytics@gmail.com>

# After jobs worker is stable
# JOBS_HEALTH_REQUIRED=1
