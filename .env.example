# Wamiro environment
# Copy to .env (dev) or /opt/wamiro/.env (Lightsail prod). Never commit real values.

# REQUIRED — RDS Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@your-instance.xxxx.region.rds.amazonaws.com:5432/wamiro?sslmode=require

# Public origin — action links in emails, CORS/host checks. One definition only.
APP_URL=http://localhost:3000

# Required in production. Encrypts mailbox IMAP passwords at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Seed script only (src/db/seed.ts): platform super admin bootstrap
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# AI assistant (optional) — any OpenAI-compatible endpoint.
# Examples: OpenRouter https://openrouter.ai/api/v1 · Groq https://api.groq.com/openai/v1
#           local Ollama http://localhost:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
# Optional OpenRouter (or similar) attribution headers — ignored by other providers.
# AI_HTTP_REFERER=https://your-app.example
# AI_APP_TITLE=Wamiro
# App-side anti-abuse only (chat posts / hour). 0 disables. Does not encode provider RPM.
# AI_CHAT_RATE_LIMIT_PER_HOUR=1000
# Embeddings for semantic search (optional; needs pgvector, migration-0016).
# Model must produce 1536-dimension vectors (e.g. text-embedding-3-small).
AI_EMBED_MODEL=text-embedding-3-small

# Uploaded documents live here (gitignored); set to a persistent disk path
WAMIRO_DATA_DIR=

# GlitchTip (self-hosted). Unset = errors stay in journald only.
# DSN from the GlitchTip project (https://key@errors.yourdomain/1)
GLITCHTIP_DSN=
GLITCHTIP_RELEASE=
GLITCHTIP_ENVIRONMENT=production

# Email notifications + activation mail (invite/welcome) — SMTP URL. Examples:
#   smtps://user:pass@smtp.gmail.com:465   smtp://user:pass@smtp.mailgun.org:587
# Transactional providers (Resend, Postmark, Mailgun…) expose an SMTP endpoint
# you can paste here. Unset = in-app only; invite temp passwords still show to
# the inviting admin.
SMTP_URL=
MAIL_FROM=Wamiro <no-reply@yourdomain.com>
# Optional: external upgrade URL used by Settings → Plan & Billing when Paddle
# is not configured (mailto fallback is used if this is also empty).
BILLING_UPGRADE_URL=

# ---------- Phase 3: Paddle self-serve billing ----------
# Sandbox until go-live. Unset API key = product still runs; checkout stays
# "Talk to sales". Webhook URL: {APP_URL}/api/v1/billing/webhook
# PADDLE_ENV=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_GROWTH=pri_...
# PADDLE_PRICE_SCALE=pri_...
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_SCALE=

# ---------- Phase D: white-label, PWA push, rate limiting ----------
# Comma-separated extra hosts served as the platform (besides APP_URL's host).
# Tenants use <slug>.<platform-host> subdomains or their own CNAME domain.
#   PLATFORM_HOSTS=wamiro.app,app.wamiro.app
PLATFORM_HOSTS=
# Web push (RFC 8292). Generate with: node scripts/gen-vapid-keys.mjs
# Unset = in-app notifications only; push subscriptions are ignored.
#   VAPID_PUBLIC_KEY=...
#   VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
#   VAPID_SUBJECT=mailto:admin@your-domain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Per-tenant API rate limiting (fixed windows, DB-backed, shared across
# instances). Defaults are sane for one instance; tighten before launch.
#   RATE_LIMIT_ORG_PER_MIN=600      # mutations+reads per tenant per minute
#   RATE_LIMIT_AUTH_PER_15MIN=40    # login attempts per IP per 15 min
#   REGISTER_RATE_LIMIT_PER_HOUR=20 # new registrations per IP per hour

# ---------- Audit durability (G-01) ----------
# When Postgres rejects an audit insert, the event retries inline, then is
# buffered to <WAMIRO_DATA_DIR>/audit-dead-letter/pending.jsonl and replayed
# by the jobs worker (audit_dlq_replay, every 15 min). Defaults are sane.
#   AUDIT_RETRY_ATTEMPTS=3          # 1 inline + N retries (150ms * attempt backoff)
#   AUDIT_RETRY_BACKOFF_MS=150
#   AUDIT_DLQ_MAX_BYTES=67108864    # roll pending.jsonl aside past 64 MB

# ---------- Audit retention (G-02) ----------
# Rows older than this many days are archived to monthly JSONL files under
# <WAMIRO_DATA_DIR>/audit-archive/ then deleted from audit_logs by the jobs
# worker's retention_sweep (bounded at 5000 rows/run, oldest first). Archive
# failure aborts the sweep before any delete — no data without a copy.
# Unset/0 = disabled (audit_logs grows unbounded). Floor: 30 days.
# AUDIT_RETENTION_DAYS=365

# ---------- Phase 4: object storage (Cloudflare R2 / S3-compatible) ----------
# When all four are set, uploaded files live in S3 (R2 free tier: 10 GB + free
# egress). Unset = local disk under WAMIRO_DATA_DIR (default ./data).
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET=wamiro-files
#   S3_ACCESS_KEY_ID=...
#   S3_SECRET_ACCESS_KEY=...
#   S3_REGION=auto                     # R2 = auto; MinIO/Wasabi may need a real region
#   S3_FORCE_PATH_STYLE=true           # path-style (safe default for R2/MinIO)
# One-time migration from local disk: node scripts/migrate-storage.mjs
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
