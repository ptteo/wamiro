# Wamiro environment
# Copy to .env (dev) or /opt/wamiro/.env (Lightsail prod). Never commit real values.

# REQUIRED — RDS Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@your-instance.xxxx.region.rds.amazonaws.com:5432/wamiro?sslmode=require

# Optional — public URL, used in emails/links later
APP_URL=http://localhost:3000
# (APP_URL appears again further down under email; keep one definition here)

# Seed script only (src/db/seed.ts): platform super admin bootstrap
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# AI assistant (optional) — any OpenAI-compatible endpoint.
# Examples: OpenRouter https://openrouter.ai/api/v1 · Groq https://api.groq.com/openai/v1
#           local Ollama http://localhost:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
# Optional OpenRouter (or similar) attribution headers — ignored by other providers.
# AI_HTTP_REFERER=https://your-app.example
# AI_APP_TITLE=Wamiro
# App-side anti-abuse only (chat posts / hour). 0 disables. Does not encode provider RPM.
# AI_CHAT_RATE_LIMIT_PER_HOUR=1000
# Embeddings for semantic search (optional; needs pgvector, migration-0016).
# Model must produce 1536-dimension vectors (e.g. text-embedding-3-small).
AI_EMBED_MODEL=text-embedding-3-small

# Uploaded documents live here (gitignored); set to a persistent disk path
WAMIRO_DATA_DIR=

# Email notifications + activation mail (invite/welcome) — SMTP URL. Examples:
#   smtps://user:pass@smtp.gmail.com:465   smtp://user:pass@smtp.mailgun.org:587
# Transactional providers (Resend, Postmark, Mailgun…) expose an SMTP endpoint
# you can paste here. Unset = in-app only; invite temp passwords still show to
# the inviting admin.
SMTP_URL=
MAIL_FROM=Wamiro <no-reply@yourdomain.com>
# Where action links in emails point (must be the public origin in production).
APP_URL=http://localhost:3000
# Optional: external upgrade URL used by Settings → Plan & Billing (e.g. a
# Stripe billing portal / payment link) once Phase B billing is wired.
BILLING_UPGRADE_URL=

# ---------- Phase D: white-label, PWA push, rate limiting ----------
# Comma-separated extra hosts served as the platform (besides APP_URL's host).
# Tenants use <slug>.<platform-host> subdomains or their own CNAME domain.
#   PLATFORM_HOSTS=wamiro.app,app.wamiro.app
PLATFORM_HOSTS=
# Web push (RFC 8292). Generate with: node scripts/gen-vapid-keys.mjs
# Unset = in-app notifications only; push subscriptions are ignored.
#   VAPID_PUBLIC_KEY=...
#   VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
#   VAPID_SUBJECT=mailto:admin@your-domain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Per-tenant API rate limiting (fixed windows, DB-backed, shared across
# instances). Defaults are sane for one instance; tighten before launch.
#   RATE_LIMIT_ORG_PER_MIN=600      # mutations+reads per tenant per minute
#   RATE_LIMIT_AUTH_PER_15MIN=40    # login attempts per IP per 15 min
#   REGISTER_RATE_LIMIT_PER_HOUR=20 # new registrations per IP per hour
